from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures

X = [[5], [10], [15], [20], [25],
     [30], [35], [40], [45], [50]]

y = [1.2, 2.5, 4.1, 6.2, 8.8,
     11.9, 15.5, 19.6, 24.2, 29.3]

new_sample = [[32]]

# Linear Regression
linear_model = LinearRegression()
linear_model.fit(X, y)
linear_prediction = linear_model.predict(new_sample)

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)
new_sample_poly = poly.transform(new_sample)

poly_model = LinearRegression()
poly_model.fit(X_poly, y)
poly_prediction = poly_model.predict(new_sample_poly)

print("Linear Regression Prediction:", linear_prediction[0])
print("Polynomial Regression Prediction:", poly_prediction[0])
