import pandas as pd

# Training Dataset
data = [
    ['High','Good','Yes','Good','High','Yes'],
    ['High','Excellent','Yes','Good','High','Yes'],
    ['Medium','Average','No','Average','Medium','No'],
    ['High','Good','Yes','Excellent','High','Yes'],
    ['Low','Poor','No','Average','Low','No'],
    ['High','Good','Yes','Good','Medium','Yes'],
    ['Medium','Good','Yes','Good','High','Yes'],
    ['Low','Average','No','Poor','Medium','No']
]

columns = ['CGPA','Communication','Internship','Programming','Aptitude','Placed']

df = pd.DataFrame(data, columns=columns)

print("Training Data")
print(df)

# Separate attributes and target
concepts = df.iloc[:, :-1].values
target = df.iloc[:, -1].values

# Initialize Specific Hypothesis
S = concepts[0].copy()

# Initialize General Hypothesis
G = [['?' for i in range(len(S))]]

print("\nInitial Specific Hypothesis:")
print(S)

print("\nInitial General Hypothesis:")
print(G)

# Candidate Elimination Algorithm
for i in range(len(concepts)):

    if target[i] == "Yes":

        for j in range(len(S)):
            if S[j] != concepts[i][j]:
                S[j] = '?'

    else:

        for j in range(len(S)):
            if S[j] != '?':
                if concepts[i][j] != S[j]:
                    G.append(['?' if k != j else S[j] for k in range(len(S))])

print("\nFinal Specific Hypothesis:")
print(S)

print("\nFinal General Hypothesis:")
for g in G:
    print(g)
