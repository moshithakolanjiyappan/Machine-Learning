from sklearn.mixture import GaussianMixture

X = [
    [40, 4.5],
    [50, 5.0],
    [60, 5.6],
    [70, 6.5],
    [80, 7.8],
    [90, 9.2],
    [100, 10.8],
    [110, 12.5],
    [120, 14.3],
    [130, 16.2]
]

gmm = GaussianMixture(n_components=2, random_state=42)
gmm.fit(X)

clusters = gmm.predict(X)

new_sample = [[95, 10.0]]
new_cluster = gmm.predict(new_sample)

print("Cluster Labels:")
print(clusters)

print("New Sample Cluster:")
print(new_cluster[0])
