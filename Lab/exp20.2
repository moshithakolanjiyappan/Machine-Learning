from sklearn.linear_model import LinearRegression
import numpy as np

# Dataset
X = np.array([
    [20, 2],
    [25, 2],
    [30, 3],
    [35, 3],
    [40, 4],
    [45, 4],
    [50, 5],
    [55, 5],
    [60, 6],
    [65, 6]
])

y = np.array([250, 290, 340, 390, 450, 510, 580, 640, 710, 780])

# Train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = np.array([[48, 5]])

# Prediction
prediction = model.predict(new_sample)

print("Dataset 1: Monthly Product Sales")
print("Predicted Future Sales:", round(prediction[0], 2), "units")
