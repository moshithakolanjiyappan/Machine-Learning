from sklearn.linear_model import LinearRegression
import numpy as np

# Dataset
X = np.array([
    [1000, 120],
    [1200, 150],
    [1400, 180],
    [1600, 220],
    [1800, 260],
    [2000, 300],
    [2200, 340],
    [2400, 380],
    [2600, 420],
    [2800, 460]
])

y = np.array([8, 10, 12, 15, 18, 22, 26, 31, 36, 42])

# Train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = np.array([[2100, 320]])

# Prediction
prediction = model.predict(new_sample)

print("Dataset 2: Retail Store Sales")
print("Predicted Future Sales:", round(prediction[0], 2), "Lakhs")
