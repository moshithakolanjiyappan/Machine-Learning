from sklearn.linear_model import LinearRegression
import numpy as np

# Dataset
X = np.array([
    [5, 150],
    [8, 180],
    [10, 220],
    [12, 260],
    [15, 300],
    [18, 340],
    [20, 380],
    [22, 420],
    [25, 460],
    [28, 500]
])

y = np.array([220, 260, 310, 360, 420, 490, 570, 650, 740, 840])

# Train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = np.array([[18, 350]])

# Prediction
prediction = model.predict(new_sample)

print("Dataset 4: Supermarket Sales")
print("Predicted Future Sales:", round(prediction[0], 2), "thousand rupees")
