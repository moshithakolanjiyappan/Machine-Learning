from sklearn.linear_model import LinearRegression
import numpy as np

# Dataset
X = np.array([
    [1000, 5000],
    [1500, 7000],
    [2000, 9000],
    [2500, 11000],
    [3000, 13000],
    [3500, 15000],
    [4000, 17000],
    [4500, 19000],
    [5000, 21000],
    [5500, 23000]
])

y = np.array([120, 180, 250, 320, 400, 490, 590, 700, 820, 950])

# Train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = np.array([[4200, 18000]])

# Prediction
prediction = model.predict(new_sample)

print("Dataset 3: Online Business Sales")
print("Predicted Future Sales:", round(prediction[0], 2), "orders")
