from sklearn.linear_model import LinearRegression

# Features: Apartment Size, Floor Number, Building Age
X = [
    [700, 1, 15],
    [850, 2, 12],
    [1000, 3, 10],
    [1150, 4, 8],
    [1300, 5, 7],
    [1450, 6, 5],
    [1600, 7, 4],
    [1750, 8, 3],
    [1900, 9, 2],
    [2050, 10, 1]
]

# House Price in Lakhs
y = [30, 38, 48, 60, 72, 86, 100, 116, 134, 154]

# Create and train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = [[1500, 6, 4]]

# Prediction
prediction = model.predict(new_sample)

print("Predicted House Price:", prediction[0], "Lakhs")
