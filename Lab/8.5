from sklearn.linear_model import LogisticRegression

X = [
    [10, 95, 50],
    [9, 92, 48],
    [8, 90, 45],
    [4, 70, 25],
    [3, 65, 20],
    [11, 96, 52],
    [5, 75, 30],
    [8, 89, 44],
    [2, 60, 18],
    [7, 87, 40]
]

y = [1, 1, 1, 0, 0, 1, 0, 1, 0, 1]

model = LogisticRegression()
model.fit(X, y)

new_sample = [[8, 91, 46]]
prediction = model.predict(new_sample)

if prediction[0] == 1:
    print("Predicted Result: Promoted")
else:
    print("Predicted Result: Not Promoted")
