from sklearn.linear_model import LinearRegression
import numpy as np

# Dataset
X = np.array([
    [30, 20],
    [35, 25],
    [40, 30],
    [45, 35],
    [50, 40],
    [55, 45],
    [60, 50],
    [65, 55],
    [70, 60],
    [75, 65]
])

y = np.array([8, 10, 13, 17, 22, 28, 35, 43, 52, 62])

# Train model
model = LinearRegression()
model.fit(X, y)

# New sample
new_sample = np.array([[58, 48]])

# Prediction
prediction = model.predict(new_sample)

print("Dataset 5: Automobile Showroom Sales")
print("Predicted Future Sales:", round(prediction[0], 2), "cars")
